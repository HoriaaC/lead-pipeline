    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst { sig, ts, expected } = $input.first().json;\n\n// timingSafeEqual throws on different lengths, so check lengths first.\nconst got = Buffer.from(String(sig));\nconst want = Buffer.from(`sha256=${expected}`);\nconst sigOk = got.length === want.length && crypto.timingSafeEqual(got, want);\n\n// Reject anything older/newer than 5 min, so a captured request can't be replayed later.\nconst fresh = /^\\d+$/.test(ts) && Math.abs(Date.now() / 1000 - Number(ts)) <= 300;\n\nreturn [{ json: { valid: sigOk && fresh } }];\n"
      },
