        "jsCode": "// Sign the raw bytes (binary \"data\"), not $json.body: n8n's parsed JSON isn't byte-identical.\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst h = $input.first().json.headers;\nreturn [{ json: { toSign: `${h['x-timestamp']}.${raw}`, ts: h['x-timestamp'] ?? '', sig: h['x-signature'] ?? '' } }];\n"
      },
