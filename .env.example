# Supabase → Connect → Direct → Session pooler (URI). Never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# HTTP Basic Auth for /dashboard. Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_at_least_12_chars

# n8n Cloud Webhook node's production URL (workflow must be published/active).
N8N_WEBHOOK_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/new-lead
# Second workflow, called by the daily summary cron (scripts/daily-summary.ts).
N8N_SUMMARY_WEBHOOK_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/daily-summary
# Shared HMAC secret; the same value goes into n8n's Crypto credential "Hmac Secret". Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SECRET=CHANGE_ME_at_least_32_chars

# MCP server (mcp/server.ts) connects as the read-only role from 002_create_readonly_role.sql.
# Same pooler host as DATABASE_URL, user = leads_reader.PROJECT_REF. Set the password once with:
#   alter role leads_reader password '...';
MCP_DATABASE_URL=postgresql://leads_reader.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
